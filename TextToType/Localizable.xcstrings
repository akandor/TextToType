    "Increase this if the target app (e.g. a remote desktop or VM) drops characters." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhöhe diesen Wert, wenn die Zielanwendung (z. B. ein Remote-Desktop oder eine virtuelle Maschine) Zeichen auslässt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Augmentez cette valeur si l’app cible (par exemple un bureau à distance ou une machine virtuelle) perd des caractères."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta questo valore se l’app di destinazione (ad esempio un desktop remoto o una macchina virtuale) perde dei caratteri."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auméntalo si la app de destino (por ejemplo, un escritorio remoto o una máquina virtual) pierde caracteres."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumente este valor se o app de destino (por exemplo, uma área de trabalho remota ou uma máquina virtual) perder caracteres."
          }
        }
      }
    },
