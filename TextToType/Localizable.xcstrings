    "Already turned on in System Settings? That entry is from an older build. Remove it with − and add this app again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits in den Systemeinstellungen aktiviert? Dieser Eintrag stammt von einer älteren Version. Entferne ihn mit „−“ und füge diese App erneut hinzu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjà activé dans Réglages Système ? Cette entrée provient d’une version antérieure. Supprimez-la avec « − » et ajoutez à nouveau cette app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Già attivato in Impostazioni di Sistema? Quella voce appartiene a una versione precedente. Rimuovila con “−” e aggiungi di nuovo questa app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ya está activado en Ajustes del Sistema? Esa entrada es de una versión anterior. Elimínala con «−» y vuelve a añadir esta app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já está ativado nos Ajustes do Sistema? Esse item é de uma versão anterior. Remova-o com “−” e adicione este app novamente."
          }
        }
      }
    },
